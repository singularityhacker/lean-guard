{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/../.lake/build/bin/lean-guard\" --policy \"$CLAUDE_PROJECT_DIR/../policies/demo.json\" || exit 2",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
